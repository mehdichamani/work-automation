# Application Configuration
NODE_ENV=production
PORT=3002
# BIND_HOST: 0.0.0.0 = accessible from all network adapters / LAN / domain; 127.0.0.1 = localhost only
BIND_HOST=0.0.0.0
# CORS_ORIGIN: Comma-separated extra allowed origins or domains (e.g. https://custom.com,*.mycompany.ir)
# Note: localhost, 127.0.0.1, LAN private IPs (192.168.x, 172.x, 10.x), and *.uromsachi.ir are allowed automatically.
# Set to * to allow all origins.
CORS_ORIGIN=*

# Admin Default Username is "1000"
# Admin Default Password (used in seed/init scripts - must be changed on first login)
ADMIN_DEFAULT_PASSWORD=admin@123

# Database Configuration (Separate fields support passwords with special characters like !@#)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edari
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Optional Legacy Connection String
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/edari?schema=public

# Camera Credentials (optional - can be set via admin panel)
CAMERA_USERNAME=
CAMERA_PASSWORD=

# Restart Secret (required for server restart endpoint)
RESTART_SECRET=your_random_secret_here
