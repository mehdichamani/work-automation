# Application Configuration
NODE_ENV=production
PORT=2833
CORS_ORIGIN=http://localhost:2833

# Database Configuration (Separate fields support passwords with special characters like !@#)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edari
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Optional Legacy Connection String
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/edari?schema=public
