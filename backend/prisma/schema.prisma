generator client {
  provider = "prisma-client-js"
  seed    = "node prisma/seed.js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  supervisor
  user
}

enum PurchaseLocation {
  Tehran
  Urmia
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?     @map("parent_id")
  parent    Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]
  letters                Letter[]
  letterUnits            LetterUnit[]
  permissions            Permission[]
  purchaseRequests       PurchaseRequest[]
  missionRequests        MissionRequest[]
  repairRequests         RepairRequest[]
  repairExternalRequests RepairExternalRequest[]
  inspectionRequests     InspectionRequest[]
  dailyOutputs           DailyOutput[]
  dailyWorkReports       DailyWorkReport[]
  workOrders             WorkOrder[]
  paymentRequests        PaymentRequest[]
  projectSupplyRequests  ProjectSupplyRequest[]

  @@map("departments")
}

model User {
  id                 Int      @id
  password           String
  fullName           String   @map("full_name")
  role               UserRole @default(user)
  departmentId       Int?     @map("department_id")
  department         Department? @relation(fields: [departmentId], references: [id])
  workType           String?  @default("normal") @map("work_type")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  username           String?
  phone              String?
  email              String?
  lastLogin          String?  @map("last_login")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  signature                Signature?
  digitalSignature         DigitalSignature?
  signatureLogs            SignatureLog[]
  leaveRequests            LeaveRequest[]
  leaveBalance             LeaveBalance?
  leaveChangeLogs          LeaveChangeLog[]
  overtimeRequests         OvertimeRequest[]
  sentLetters              Letter[]              @relation("LetterSender")
  letterManagerLetters     Letter[]              @relation("LetterManager")
  letterCentralLetters     Letter[]              @relation("LetterCentral")
  letterSelectedMgmtLetters Letter[]             @relation("LetterSelectedManager")
  letterHistory            LetterHistory[]
  notifications            Notification[]
  activityLogs             ActivityLog[]
  purchaseRequests         PurchaseRequest[]
  missionRequests          MissionRequest[]
  repairRequests           RepairRequest[]
  repairExternalRequests   RepairExternalRequest[]
  inspectionRequests       InspectionRequest[]
  dailyOutputs             DailyOutput[]
  dailyWorkReports         DailyWorkReport[]
  itRequests               ItRequest[]
  itRequestAssigned        ItRequest[]           @relation("ItRequestAssigned")
  workOrders               WorkOrder[]
  paymentRequests          PaymentRequest[]
  conferenceBookings       ConferenceBooking[]
  securityReports          SecurityReport[]
  projectSupplyRequests    ProjectSupplyRequest[]
  chatRooms                ChatRoom[]
  chatMembers              ChatMember[]
  chatMessages             ChatMessage[]
  workflowTemplates        WorkflowTemplate[]
  workflowInstances        WorkflowInstance[]
  workflowStepsLog         WorkflowStepLog[]
  cardexItems              Cardex[]              @relation("CardexUser")
  cardexWarehouseItems     Cardex[]              @relation("CardexWarehouse")
  restaurantReservations   RestaurantReservation[]
  userShiftAssignments     UserShiftAssignment[]
  shiftChangeRequests      ShiftChangeRequest[]
  shiftReviewers           ShiftChangeRequest[]  @relation("ShiftReviewer")
  announcements            Announcement[]
  jobApplications          JobApplication[]
  jobApplicationReviews    JobApplication[]      @relation("JobAppReviewer")
  educationalMaterials     EducationalMaterial[]
  pushSubscriptions        PushSubscription[]
  attachments              Attachment[]
  smsCodes                 SmsCode[]
  csvImportLogs            CsvImportLog[]
  backupLogs               BackupLog[]
  permissions              Permission[]

  @@map("users")
}
model Signature {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageData String   @map("image_data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("signatures")
}

model DigitalSignature {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureData    String   @map("signature_data")
  signatureType    String   @default("drawn") @map("signature_type")
  scannedSignature String?  @map("scanned_signature")
  employeeCode     String?  @map("employee_code")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  signatureLogs SignatureLog[]
  @@map("digital_signatures")
}

model SignatureLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureId Int?     @map("signature_id")
  signature   DigitalSignature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  moduleName  String?  @map("module_name")
  recordId    Int?     @map("record_id")
  action      String
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("signature_logs")
}

model LeaveRequest {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType          String   @map("leave_type")
  startDate          String   @map("start_date")
  endDate            String   @map("end_date")
  startHour          String?  @map("start_hour")
  endHour            String?  @map("end_hour")
  hoursCount         Float    @map("hours_count")
  reason             String?
  status             String   @default("pending_supervisor")
  supervisorId       Int?     @map("supervisor_id")
  supervisorComment  String?  @map("supervisor_comment")
  supervisorDate     String?  @map("supervisor_date")
  adminId            Int?     @map("admin_id")
  adminComment       String?  @map("admin_comment")
  adminDate          String?  @map("admin_date")
  managerId          Int?     @map("manager_id")
  managerComment     String?  @map("manager_comment")
  managerDate        String?  @map("manager_date")
  securityId         Int?     @map("security_id")
  securityDate       String?  @map("security_date")
  editedBy           Int?     @map("edited_by")
  editedAt           String?  @map("edited_at")
  editReason         String?  @map("edit_reason")
  remainingLeaveDays Float?   @map("remaining_leave_days")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  @@map("leave_requests")
}

model LeaveBalance {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalDays Float   @default(0) @map("total_days")
  usedHours Float   @default(0) @map("used_hours")
  @@map("leave_balance")
}

model LeaveChangeLog {
  id         Int      @id @default(autoincrement())
  actionBy   Int      @map("action_by")
  actor      User     @relation(fields: [actionBy], references: [id], onDelete: Cascade)
  actionType String   @map("action_type")
  targetId   Int      @map("target_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("leave_change_logs")
}

model OfficialHoliday {
  id          Int      @id @default(autoincrement())
  holidayDate String   @unique @map("holiday_date")
  title       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("official_holidays")
}

model OvertimeRequest {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate         String   @map("start_date")
  endDate           String   @map("end_date")
  startHour         String?  @map("start_hour")
  endHour           String?  @map("end_hour")
  hoursCount        Float    @map("hours_count")
  reason            String?
  status            String   @default("pending_supervisor")
  supervisorId      Int?     @map("supervisor_id")
  supervisorComment String?  @map("supervisor_comment")
  supervisorDate    String?  @map("supervisor_date")
  managerId         Int?     @map("manager_id")
  managerComment    String?  @map("manager_comment")
  managerDate       String?  @map("manager_date")
  securityId        Int?     @map("security_id")
  securityDate      String?  @map("security_date")
  editedBy          Int?     @map("edited_by")
  editedAt          String?  @map("edited_at")
  editReason        String?  @map("edit_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  @@map("overtime_requests")
}

model Letter {
  id                Int      @id @default(autoincrement())
  letterNumber      String?  @map("letter_number")
  subject           String
  body              String?
  senderId          Int      @map("sender_id")
  sender            User     @relation("LetterSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderUnitId      Int      @map("sender_unit_id")
  senderUnit        Department @relation(fields: [senderUnitId], references: [id], onDelete: Cascade)
  priority          String   @default("normal")
  status            String   @default("pending_central")
  selectedManagerId Int?     @map("selected_manager_id")
  selectedManager   User?    @relation("LetterSelectedManager", fields: [selectedManagerId], references: [id], onDelete: SetNull)
  centralId         Int?     @map("central_id")
  central           User?    @relation("LetterCentral", fields: [centralId], references: [id], onDelete: SetNull)
  centralDate       String?  @map("central_date")
  centralComment    String?  @map("central_comment")
  managerId         Int?     @map("manager_id")
  manager           User?    @relation("LetterManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerComment    String?  @map("manager_comment")
  managerDate       String?  @map("manager_date")
  signatureData     String?  @map("signature_data")
  attachmentName    String?  @map("attachment_name")
  attachmentPath    String?  @map("attachment_path")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  units       LetterUnit[]
  attachments LetterAttachment[]
  history     LetterHistory[]
  @@map("letters")
}

model LetterUnit {
  id       Int      @id @default(autoincrement())
  letterId Int      @map("letter_id")
  letter   Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  unitId   Int      @map("unit_id")
  unit     Department @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status   String   @default("pending")
  seenDate String?  @map("seen_date")
  @@map("letter_units")
}

model LetterAttachment {
  id        Int      @id @default(autoincrement())
  letterId  Int      @map("letter_id")
  letter    Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("letter_attachments")
}

model LetterCounter {
  id         Int @id @default(autoincrement())
  year       Int @unique
  lastNumber Int @default(0) @map("last_number")
  @@map("letter_counter")
}

model LetterHistory {
  id        Int      @id @default(autoincrement())
  letterId  Int      @map("letter_id")
  letter    Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String?  @map("user_name")
  action    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("letter_history")
}

model PurchaseRequest {
  id                    Int      @id @default(autoincrement())
  requestNumber         String?  @map("request_number")
  userId                Int      @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department            String?
  description           String?
  reason                String?
  urgency               String   @default("normal")
  departmentId          Int?     @map("department_id")
  dept                  Department? @relation(fields: [departmentId], references: [id])
  status                String   @default("pending_supervisor")
  supervisorId          Int?     @map("supervisor_id")
  supervisorComment     String?  @map("supervisor_comment")
  supervisorDate        String?  @map("supervisor_date")
  managerId             Int?     @map("manager_id")
  managerComment        String?  @map("manager_comment")
  managerDate           String?  @map("manager_date")
  warehouseId           Int?     @map("warehouse_id")
  warehouseComment      String?  @map("warehouse_comment")
  warehouseDate         String?  @map("warehouse_date")
  factoryManagerId      Int?     @map("factory_manager_id")
  factoryManagerComment String?  @map("factory_manager_comment")
  factoryManagerDate    String?  @map("factory_manager_date")
  budgetId              Int?     @map("budget_id")
  budgetComment         String?  @map("budget_comment")
  budgetDate            String?  @map("budget_date")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  items PurchaseItem[]
  @@map("purchase_requests")
}

model PurchaseItem {
  id                Int     @id @default(autoincrement())
  requestId         Int     @map("request_id")
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rowIndex          Int     @default(0) @map("row_index")
  itemCode          String? @map("item_code")
  description       String?
  purchaseLocation  String? @map("purchase_location")
  technicalSpecs    String? @map("technical_specs")
  requestedQuantity Float   @default(0) @map("requested_quantity")
  approvedQuantity  Float   @default(0) @map("approved_quantity")
  usageLocation     String? @map("usage_location")
  price             Float   @default(0)
  unit              String?
  @@map("purchase_items")
}

model PurchaseCounter {
  id         Int @id @default(autoincrement())
  year       Int @unique
  lastNumber Int @default(0) @map("last_number")
  @@map("purchase_counter")
}

model PurchaseHistory {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  userId    Int?     @map("user_id")
  userName  String?  @map("user_name")
  action    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("purchase_history")
}

model MissionRequest {
  id                Int      @id @default(autoincrement())
  requestNumber     String?  @map("request_number")
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionDate       String   @map("mission_date")
  startTime         String?  @map("start_time")
  endTime           String?  @map("end_time")
  destination       String?
  missionType       String?  @map("mission_type")
  description       String?
  reason            String?
  departmentId      Int?     @map("department_id")
  dept              Department? @relation(fields: [departmentId], references: [id])
  status            String   @default("pending_supervisor")
  supervisorId      Int?     @map("supervisor_id")
  supervisorComment String?  @map("supervisor_comment")
  supervisorDate    String?  @map("supervisor_date")
  managerId         Int?     @map("manager_id")
  managerComment    String?  @map("manager_comment")
  managerDate       String?  @map("manager_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  history MissionHistory[]
  @@map("mission_requests")
}

model MissionCounter {
  id         Int @id @default(autoincrement())
  year       Int @unique
  lastNumber Int @default(0) @map("last_number")
  @@map("mission_counter")
}

model MissionHistory {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  request   MissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    Int?     @map("user_id")
  userName  String?  @map("user_name")
  action    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("mission_history")
}

model RepairRequest {
  id                Int      @id @default(autoincrement())
  requestNumber     String?  @map("request_number")
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  equipmentName     String?  @map("equipment_name")
  location          String?
  urgency           String   @default("normal")
  estimatedCost     String?  @map("estimated_cost")
  desiredDate       String?  @map("desired_date")
  departmentId      Int?     @map("department_id")
  dept              Department? @relation(fields: [departmentId], references: [id])
  status            String   @default("pending_supervisor")
  images            String?
  supervisorId      Int?     @map("supervisor_id")
  supervisorComment String?  @map("supervisor_comment")
  supervisorDate    String?  @map("supervisor_date")
  managerId         Int?     @map("manager_id")
  managerComment    String?  @map("manager_comment")
  managerDate       String?  @map("manager_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  history RepairHistory[]
  @@map("repair_requests")
}

model RepairCounter {
  id         Int @id @default(autoincrement())
  year       Int @unique
  lastNumber Int @default(0) @map("last_number")
  @@map("repair_counter")
}

model RepairHistory {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    Int?     @map("user_id")
  userName  String?  @map("user_name")
  action    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("repair_history")
}

model RepairExternalRequest {
  id                       Int      @id @default(autoincrement())
  requestNumber            String?  @map("request_number")
  userId                   Int      @map("user_id")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId             Int?     @map("department_id")
  department               Department? @relation(fields: [departmentId], references: [id])
  status                   String   @default("draft")
  docCode                  String?  @default("PM_01") @map("doc_code")
  editDate                 String?  @map("edit_date")
  revisionNumber           String?  @map("revision_number")
  formDate                 String?  @map("form_date")
  fromUnit                 String?  @map("from_unit")
  toUnit                   String?  @map("to_unit")
  managerName              String?  @map("manager_name")
  requestDate              DateTime @default(now()) @map("request_date")
  urgency                  String   @default("normal")
  repairSpeed              String   @default("urgent") @map("repair_speed")
  deadline                 String?
  workType                 String?  @map("work_type")
  techDescription          String?  @map("tech_description")
  estimatedCost            String?  @map("estimated_cost")
  faultDescription         String?  @map("fault_description")
  faultReason              String?  @map("fault_reason")
  warehouseStock           Int?     @default(0) @map("warehouse_stock")
  warehouseStockStatus     String?  @map("warehouse_stock_status")
  equipmentName            String?  @map("equipment_name")
  sketchFile               String?  @map("sketch_file")
  photoFile                String?  @map("photo_file")
  deliveryDate             String?  @map("delivery_date")
  sendDate                 String?  @map("send_date")
  sendSerial               String?  @map("send_serial")
  destination              String?
  contractorName           String?  @map("contractor_name")
  contractorAddress        String?  @map("contractor_address")
  repairDescription        String?  @map("repair_description")
  repairCost               String?  @map("repair_cost")
  supporterName            String?  @map("supporter_name")
  returnDate               String?  @map("return_date")
  returnSerial             String?  @map("return_serial")
  qualityStatus            String?  @map("quality_status")
  qualityNotes             String?  @map("quality_notes")
  images                   String?
  pmApproved               Boolean  @default(false) @map("pm_approved")
  pmApprovedAt             String?  @map("pm_approved_at")
  pmId                     Int?     @map("pm_id")
  deptManagerApproved      Boolean  @default(false) @map("dept_manager_approved")
  deptManagerApprovedAt    String?  @map("dept_manager_approved_at")
  deptManagerId            Int?     @map("dept_manager_id")
  techManagerApproved      Boolean  @default(false) @map("tech_manager_approved")
  techManagerApprovedAt    String?  @map("tech_manager_approved_at")
  techManagerId            Int?     @map("tech_manager_id")
  warehouseApproved        Boolean  @default(false) @map("warehouse_approved")
  warehouseApprovedAt      String?  @map("warehouse_approved_at")
  warehouseId              Int?     @map("warehouse_id")
  factoryManagerApproved   Boolean  @default(false) @map("factory_manager_approved")
  factoryManagerApprovedAt String?  @map("factory_manager_approved_at")
  factoryManagerId         Int?     @map("factory_manager_id")
  supportCompleted         Boolean  @default(false) @map("support_completed")
  supportCompletedAt       String?  @map("support_completed_at")
  qualityApproved          Boolean  @default(false) @map("quality_approved")
  qualityApprovedAt        String?  @map("quality_approved_at")
  finalWarehouseApproved   Boolean  @default(false) @map("final_warehouse_approved")
  finalWarehouseApprovedAt String?  @map("final_warehouse_approved_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  items   RepairExternalItem[]
  history RepairExternalHistory[]
  @@map("repair_external_requests")
}

model RepairExternalItem {
  id              Int      @id @default(autoincrement())
  requestId       Int      @map("request_id")
  request         RepairExternalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemName        String?  @map("item_name")
  techSpecs       String?  @map("tech_specs")
  serialNumber    String?  @map("serial_number")
  quantity        Int      @default(1)
  attachmentsDesc String?  @map("attachments_desc")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@map("repair_external_items")
}

model RepairExternalHistory {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  request   RepairExternalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    Int?     @map("user_id")
  userName  String?  @map("user_name")
  action    String
  comment   String?
  oldStatus String?  @map("old_status")
  newStatus String?  @map("new_status")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("repair_external_history")
}

model InspectionRequest {
  id                Int      @id @default(autoincrement())
  requestNumber     String?  @map("request_number")
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  equipmentName     String?  @map("equipment_name")
  location          String?
  inspectionType    String?  @map("inspection_type")
  urgency           String   @default("normal")
  deadline          String?
  departmentId      Int?     @map("department_id")
  dept              Department? @relation(fields: [departmentId], references: [id])
  status            String   @default("pending_supervisor")
  supervisorId      Int?     @map("supervisor_id")
  supervisorComment String?  @map("supervisor_comment")
  supervisorDate    String?  @map("supervisor_date")
  managerId         Int?     @map("manager_id")
  managerComment    String?  @map("manager_comment")
  managerDate       String?  @map("manager_date")
  result            String?  @map("inspection_result")
  inspectorId       Int?     @map("assigned_to")
  inspectorComment  String?  @map("inspection_description")
  inspectedAt       String?  @map("inspect_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  history InspectionHistory[]
  @@map("inspection_requests")
