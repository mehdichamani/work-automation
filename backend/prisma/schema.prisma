  smokingDuration          String?  @map("smoking_duration")
  foreignLanguages         String?  @map("foreign_languages")
  turkishKnown             String?  @default("خیر") @map("turkish_known")
  computerSkills           String?  @map("computer_skills")
  trainingCourses          String?  @map("training_courses")
  referencesInfo           String?  @map("references_info")
  photo                    String?
  status                   String   @default("new")
  reviewedBy               Int?     @map("reviewed_by")
  reviewer                 User?    @relation("JobAppReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt               String?  @map("reviewed_at")
  reviewComment            String?  @map("review_comment")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  workHistory JobApplicationWorkHistory[]
  attachments JobApplicationAttachment[]
  @@map("job_applications")
}

model JobApplicationWorkHistory {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  orgName       String?  @map("org_name")
  position      String?
  duration      String?
  lastSalary    String?  @map("last_salary")
  leaveReason   String?  @map("leave_reason")
  contactInfo   String?  @map("contact_info")
  sortOrder     Int      @default(0) @map("sort_order")
  @@map("job_application_work_history")
}

model JobApplicationAttachment {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String   @map("file_name")
  filePath      String   @map("file_path")
  fileType      String?  @map("file_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("job_application_attachments")
}

model JobApplicationCounter {
  id         Int @id @default(autoincrement())
  year       Int @unique
  lastNumber Int @default(0) @map("last_number")
  @@map("job_application_counter")
}

model EducationalMaterial {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  category       String   @default("pdf")
  fileUrl        String   @map("file_url")
  fileType       String?  @map("file_type")
  fileSize       Int      @default(0) @map("file_size")
  thumbnailUrl   String?  @map("thumbnail_url")
  targetAudience String   @default("all") @map("target_audience")
  tags           String[]
  isActive       Boolean  @default(true) @map("is_active")
  uploadedBy     Int      @map("uploaded_by")
  uploader       User     @relation(fields: [uploadedBy], references: [id])
  viewCount      Int      @default(0) @map("view_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@map("educational_materials")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleName String?  @map("module_name")
  action     String
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("activity_log")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  originalName String?  @map("original_name")
  mimetype     String?
  size         Int?
  url          String
  moduleName   String?  @map("module_name")
  recordId     Int?     @map("record_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("attachments")
}

model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt String   @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([phone])
  @@map("sms_codes")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("push_subscriptions")
}

model BackupSetting {
  id                   Int      @id @default(autoincrement())
  dailyPath            String?  @map("daily_path")
  weeklyPath           String?  @map("weekly_path")
  dailyHour            Int      @default(23) @map("daily_hour")
  dailyMinute          Int      @default(0) @map("daily_minute")
  weeklyDay            Int      @default(5) @map("weekly_day")
  weeklyHour           Int      @default(14) @map("weekly_hour")
  weeklyMinute         Int      @default(0) @map("weekly_minute")
  dailyRetentionDays   Int      @default(30) @map("daily_retention_days")
  weeklyRetentionWeeks Int      @default(12) @map("weekly_retention_weeks")
  dailyEnabled         Boolean  @default(true) @map("daily_enabled")
  weeklyEnabled        Boolean  @default(true) @map("weekly_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  @@map("backup_settings")
}

model BackupLog {
  id           Int      @id @default(autoincrement())
  type         String
  date         String
  dbFile       String?  @map("db_file")
  dbSize       Int?     @map("db_size")
  uploadsFile  String?  @map("uploads_file")
  uploadsSize  Int?     @map("uploads_size")
  uploadsFiles Int?     @map("uploads_files")
  backupDir    String?  @map("backup_dir")
  status       String   @default("success")
  error        String?
  createdBy    Int?     @map("created_by")
  creator      User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("backup_logs")
}

model CsvImportLog {
  id         Int      @id @default(autoincrement())
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  importedBy Int      @map("imported_by")
  importer   User     @relation(fields: [importedBy], references: [id], onDelete: Cascade)
  importedAt DateTime @default(now()) @map("imported_at")
  rowCount   Int      @map("row_count")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("csv_imports_log")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("settings")
}
